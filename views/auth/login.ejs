<%- include('../layouts/header') %>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<style>
  body {
    background: linear-gradient(135deg, #eef2f3, #dfe9f3);
    font-family: 'Segoe UI', sans-serif;
  }

  .login-wrapper {
    min-height: 90vh;
    display: flex;
    align-items: center;
    padding: 2rem;
  }

  .left-illustration img {
    max-width: 500px;
    border-radius: 16px;
    animation: floatAnim 4s ease-in-out infinite;
  }

  @keyframes floatAnim {
    0% { transform: translateY(0px); }
    50% { transform: translateY(-12px); }
    100% { transform: translateY(0px); }
  }

  .form-card {
    background: white;
    padding: 2.5rem;
    border-radius: 14px;
    width: 100%;
    max-width: 420px;
    box-shadow: 0 8px 20px rgba(0,0,0,0.08);
  }

  .form-card h2 {
    font-weight: 600;
    margin-bottom: 1.5rem;
    text-align: center;
  }

  .form-card label {
    font-weight: 500;
    margin-top: 1rem;
  }

  .form-card input {
    border-radius: 8px;
    padding: 0.65rem;
    border: 1px solid #ccc;
  }

  .btn-primary {
    width: 100%;
    padding: 0.75rem;
    border-radius: 10px;
    font-size: 1rem;
    font-weight: 500;
  }

  .btn-primary:hover {
    background-color: #1D4ED8;
  }

  .error {
    color: #dc2626;
    font-size: 0.9rem;
    margin-top: 0.5rem;
  }
</style>

<div class="container-fluid login-wrapper">
  <div class="row w-100">

    <!-- Left illustration -->
    <div class="col-lg-6 d-none d-lg-flex align-items-center justify-content-center left-illustration">
      <img src="/images/login_img.jpg" alt="Login Illustration" />
    </div>

    <!-- Right form -->
    <div class="col-lg-6 d-flex justify-content-center align-items-center">
      <form action="/auth/login" method="POST" class="form-card">

        <h2><i class="fas fa-right-to-bracket me-2"></i>Login to TalentMap</h2>

        <label for="email">Email</label>
        <input type="email" name="email" id="email" class="form-control" required />

        <label for="password">Password</label>
        <input type="password" name="password" id="password" class="form-control" required />

        <% if (typeof error !== 'undefined') { %>
          <p class="error"><%= error %></p>
        <% } %>

        <button type="submit" class="btn btn-primary mt-3">
          <i class="fas fa-sign-in-alt me-2"></i> Login
        </button>

        <div class="text-center mt-3">
          <a href="/auth/register">Don't have an account? Register</a>
        </div>

      </form>
    </div>

  </div>
</div>

<%- include('../layouts/footer') %>
