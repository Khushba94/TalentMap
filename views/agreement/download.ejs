<%- include('../layouts/header', { user: user }) %>

<div class="container my-5">
  <div class="row justify-content-center">
    <div class="col-md-10 col-lg-8">

      <div class="card job-card shadow-sm border-0 text-center">
        <div class="card-body py-5">

          <!-- Icon + Title -->
          <i class="fas fa-file-contract fa-3x text-orange mb-3"></i>
          <h2 class="text-orange mb-3">Your Agreement is Ready</h2>

          <!-- Message -->
          <p class="text-dark mb-4">The agreement has been generated successfully.</p>

          <!-- Download Button -->
          <a class="btn btn-orange btn-lg" href="<%= filePath %>" download>
            <i class="fas fa-download me-1"></i>Download Agreement PDF
          </a>

        </div>
      </div>

    </div>
  </div>
</div>

<%- include('../layouts/footer') %>

<style>
  .text-orange {
    color: #f97316;
  }

  .text-dark {
    color: #333 !important;
  }

  .btn-orange {
    background-color: #f97316;
    color: #fff;
    border: none;
    transition: background-color 0.3s ease;
  }

  .btn-orange:hover {
    background-color: #ea580c;
  }

  .job-card {
    background: #fff7ed;
    border-radius: 12px;
    padding: 2rem;
  }
</style>
