<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- Bootstrap + Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

  <title>TalentMap</title>

  <style>
    .navbar-orange {
      background-color: #f97316 !important;
      padding: 0.75rem 1rem;
      box-shadow: 0 2px 6px rgba(0,0,0,0.08);
    }

    .navbar-orange .navbar-brand {
      font-size: 1.5rem;
      font-weight: 700;
      color: #fff !important;
      display: flex;
      align-items: center;
    }

    .navbar-orange .nav-link {
      color: #fff !important;
      font-weight: 500;
      padding: 0.5rem 1rem;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .navbar-orange .nav-link:hover {
      color: #ffe4c4 !important;
      text-decoration: underline;
    }

    .navbar-toggler {
      border-color: rgba(255,255,255,0.4);
    }

    .navbar-toggler-icon {
      filter: invert(1);
    }
  </style>
</head>

<body>

<nav class="navbar navbar-expand-lg navbar-orange">
  <div class="container">

    <!-- Brand -->
    <a class="navbar-brand" href="/">
      <i class="fas fa-solid fa-link me-2"></i>TalentMap
    </a>

    <!-- Mobile Toggle -->
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
      <span class="navbar-toggler-icon"></span>
    </button>

    <!-- Menu -->
    <div class="collapse navbar-collapse" id="mainNavbar">
      <ul class="navbar-nav ms-auto">

        <% if (user) { %>

          <% if (user.role === 'recruiter') { %>
            <li class="nav-item">
              <a class="nav-link" href="/jobs/create">
                <i class="fas fa-plus"></i> Create Jobs
              </a>
            </li>

            <li class="nav-item">
              <a class="nav-link" href="/jobs/list">
                <i class="fas fa-briefcase"></i> Jobs
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/recruiter/resumes">
                <i class="fas fa-file-alt"></i> View Resumes
              </a>
            </li>
          <% } else { %>

            <li class="nav-item">
              <a class="nav-link" href="/resume/upload">
                <i class="fas fa-file-upload"></i> Upload Resume
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/offer/upload">
                <i class="fas fa-file-signature"></i> Upload Offer Letter
              </a>
            </li>

            <li class="nav-item">
              <a class="nav-link" href="/jobs/list">
                <i class="fas fa-briefcase"></i> Jobs
              </a>
            </li>

          <% } %>

          <li class="nav-item">
            <a class="nav-link" href="/auth/logout">
              <i class="fas fa-right-from-bracket"></i> Logout
            </a>
          </li>

        <% } else { %>

          <li class="nav-item">
            <a class="nav-link" href="/auth/login">
              <i class="fas fa-sign-in-alt"></i> Login
            </a>
          </li>

          <li class="nav-item">
            <a class="nav-link" href="/auth/register">
              <i class="fas fa-user-plus"></i> Register
            </a>
          </li>

        <% } %>

      </ul>
    </div>
  </div>
</nav>

<main>
