<%- include('../layouts/header', { user: user }) %>

<div class="container my-5">
  <div class="row justify-content-center">
    <div class="col-md-10 col-lg-8">

      <div class="card job-card shadow-sm border-0">
        <div class="card-body">

          <!-- Header Section -->
          <div class="text-center mb-4">
            <i class="fas fa-file-arrow-up fa-2x text-orange mb-3"></i>
            <h2 class="text-orange">Upload Resume</h2>
            <p class="text-muted">Please upload your resume in PDF, DOC, or DOCX format.</p>
          </div>

          <!-- Upload Form -->
          <form action="/resume/upload" method="POST" enctype="multipart/form-data">

            <div class="mb-4">
              <label for="resume" class="form-label fw-semibold text-dark">
                <i class="fas fa-file-alt me-1"></i>Choose File
              </label>
              <input type="file" class="form-control form-control-lg text-dark" id="resume" name="resume" required>
              <div class="form-text">Accepted formats: .pdf, .doc, .docx</div>
            </div>

            <div class="text-end">
              <button type="submit" class="btn btn-orange btn-lg">
                <i class="fas fa-upload me-1"></i>Upload
              </button>
            </div>

          </form>

        </div>
      </div>

    </div>
  </div>
</div>

<%- include('../layouts/footer') %>

<style>
  .text-orange {
    color: #f97316;
  }

  .text-dark {
    color: #333 !important;
  }

  .btn-orange {
    background-color: #f97316;
    color: #fff;
    border: none;
    transition: background-color 0.3s ease;
  }

  .btn-orange:hover {
    background-color: #ea580c;
  }

  .job-card {
    background: #fff7ed;
    border-radius: 12px;
    padding: 2rem;
  }

  .form-control {
    border-radius: 8px;
    color: #333;
    transition: box-shadow 0.2s ease;
  }

  .form-control:focus {
    box-shadow: 0 0 0 0.2rem rgba(249, 115, 22, 0.25);
    border-color: #f97316;
  }

  .form-text {
    font-size: 0.875rem;
    color: #6c757d;
  }
</style>
