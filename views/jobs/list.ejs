<%- include('../layouts/header', { user: user }) %>

<div class="d-flex justify-content-center mt-4">
  <div class="job-list-wrapper">

    <% if (!jobs.length) { %>
      <p class="text-center text-muted">No jobs available yet.</p>
    <% } else { %>

      <div class="list-group">

        <% jobs.forEach(j => { %>
          <div class="list-group-item job-list-item mb-3 shadow-sm">

            <!-- Job Title -->
            <h5 class="mb-1">
              <a href="/jobs/details/<%= j.id %>" class="text-orange fw-bold text-decoration-none">
                <%= j.title %>
              </a>
            </h5>

            <!-- Location -->
            <p class="text-muted mb-2">
              <i class="fas fa-location-dot me-1"></i> <%= j.location %>
            </p>
            <!-- Job requirements -->
            <p class="text-muted mb-2">
              <i class="fas fa-list-check me-1"></i> <%= j.requirements %>
            </p>

            <!-- Action Buttons -->
            <div class="d-flex">
              <a href="/jobs/details/<%= j.id %>" class="btn btn-outline-orange btn-sm">
                <i class="fas fa-eye"></i> View
              </a>

              <% if (user.role === 'recruiter') { %>
                <a href="/jobs/edit/<%= j.id %>" class="btn btn-outline-warning btn-sm ms-2">
                  <i class="fas fa-edit"></i> Edit
                </a>

                <form action="/jobs/delete/<%= j.id %>" method="POST" class="ms-2">
                  <button type="submit" class="btn btn-outline-danger btn-sm"
                    onclick="return confirm('Are you sure you want to delete this job?');">
                    <i class="fas fa-trash"></i> Delete
                  </button>
                </form>
              <% } %>
            </div>

          </div>
        <% }) %>

      </div>

    <% } %>

  </div>
</div>

<%- include('../layouts/footer') %>
<style>
  .job-list-wrapper {
    width: 100%;
    max-width: 600px; /* controls how wide the centered list is */
  }

  .job-list-item {
    background: #fff7ed;
    border-radius: 10px;
    padding: 1.2rem;
  }

  .text-orange {
    color: #f97316;
  }

  .btn-outline-orange {
    border-color: #f97316;
    color: #f97316;
  }

  .btn-outline-orange:hover {
    background-color: #f97316;
    color: #fff;
  }
</style>
