<%- include('../layouts/header', { user: user }) %>

<div class="container my-5">
  <div class="card job-card shadow-sm border-0">
    <div class="card-body">

      <h2 class="text-center text-orange mb-4">
        <i class="fas fa-plus-circle me-2"></i>Create a New Job
      </h2>

      <form action="/jobs/create" method="POST">
        <!-- Title -->
        <div class="mb-3">
          <label for="title" class="form-label fw-semibold">
            <i class="fas fa-briefcase me-1"></i>Job Title
          </label>
          <input type="text" class="form-control" id="title" name="title" required />
        </div>

        <!-- Location -->
        <div class="mb-3">
          <label for="location" class="form-label fw-semibold">
            <i class="fas fa-location-dot me-1"></i>Location
          </label>
          <input type="text" class="form-control" id="location" name="location" required />
        </div>

        <!-- Description -->
        <div class="mb-3">
          <label for="description" class="form-label fw-semibold">
            <i class="fas fa-align-left me-1"></i>Description
          </label>
          <textarea class="form-control" id="description" name="description" rows="4" required></textarea>
          <div class="form-text">Use line breaks for separate responsibilities.</div>
        </div>

        <!-- Requirements -->
        <div class="mb-3">
          <label for="requirements" class="form-label fw-semibold">
            <i class="fas fa-list-check me-1"></i>Requirements
          </label>
          <textarea class="form-control" id="requirements" name="requirements" rows="3" required></textarea>
          <div class="form-text">Separate items with commas.</div>
        </div>

        <!-- Submit -->
        <div class="text-end">
          <button type="submit" class="btn btn-orange">
            <i class="fas fa-paper-plane me-1"></i>Post Job
          </button>
        </div>
      </form>

    </div>
  </div>
</div>

<%- include('../layouts/footer') %>

<style>
  .text-orange {
    color: #f97316;
  }

  .btn-orange {
    background-color: #f97316;
    color: #fff;
    border: none;
  }

  .btn-orange:hover {
    background-color: #ea580c;
  }

  .job-card {
    max-width: 760px;
    margin: 0 auto;
    background: #fff7ed;
    border-radius: 12px;
    padding: 1.5rem;
  }

  .form-label {
    color: #444;
  }

  .form-control {
    border-radius: 8px;
  }
</style>
